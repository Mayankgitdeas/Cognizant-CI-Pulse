# ── Cognizant Competitor Pulse — environment variables ──────────────────────
# Copy this file to .env and customize. NEVER commit your real .env file.

# ── DATABASE ────────────────────────────────────────────────────────────────
# Local SQLite (a file on disk). For Azure production: postgresql://...
DATABASE_URL=sqlite:///./pulse.db

# ── ADMIN PANEL CREDENTIALS ─────────────────────────────────────────────────
# Used to log into /admin. Change these before sharing the URL with anyone!
# In production, manage users in a real users table and Azure AD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── SESSION SECURITY ────────────────────────────────────────────────────────
# A random string used to sign session cookies. Change to anything random.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=please-change-this-to-a-random-long-string

# ── SERVER ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
